---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { postSlug } from '../../utils/post';
import { withBase } from '../../utils/url';

const showDrafts = import.meta.env.DEV;

const posts = (await getCollection('blog'))
	.filter((post) => showDrafts || !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// frontmatter 里写的是 2026-10-11 这种，会被解析成 UTC 零点。
// 所以取年月日要用 ISO 字符串，不能用 getFullYear()/getDate()——
// 后者按本地时区算，在 UTC 负偏移的机器上会整体差一天。
const isoDay = (date) => date.toISOString().slice(0, 10);

// 按年份分组。posts 已经按日期倒序，所以顺序遍历、遇到新的一年就开一组，
// 天然就是「新的年份在前」，不需要再排一次。
const byYear = [];
for (const post of posts) {
	const year = isoDay(post.data.pubDate).slice(0, 4);
	const last = byYear[byYear.length - 1];
	if (!last || last.year !== year) {
		byYear.push({ year, posts: [post] });
	} else {
		last.posts.push(post);
	}
}
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} appendSiteName={false} />
	</head>
	<body class="page-list">
		<Header />
		<main>
			<!-- 页面上不放大标题，但给屏幕阅读器和搜索引擎留一个 -->
			<h1 class="sr-only">全部笔记</h1>

			{
				byYear.map((group) => (
					<section class="year">
						<h2 class="year-label">{group.year}</h2>
						<ul>
							{group.posts.map((post) => (
								<li>
									<a href={withBase(`blog/${postSlug(post)}/`)}>
										{/* 年份已经在分组标题上了，行内只留月-日 */}
										<span class="date">{isoDay(post.data.pubDate).slice(5)}</span>
										<span class="title">{post.data.title}</span>
									</a>
								</li>
							))}
						</ul>
					</section>
				))
			}
		</main>
		<Footer />
	</body>
</html>
