---
interface Props {
	date: Date;
}

const { date } = Astro.props;
---

<time datetime={date.toISOString()}>
	{
		// 固定用 UTC，避免构建机器时区不同导致日期差一天
		// （比如 pubDate 写 2024-01-01，在 UTC-5 的机器上会被显示成 2023-12-31）
		date.toLocaleDateString('zh-CN', {
			year: 'numeric',
			month: 'long',
			day: 'numeric',
			timeZone: 'UTC',
		})
	}
</time>
