---
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<!-- 站点名先不显示（还没有 logo）。navbar 用三栏网格，中间那栏放导航链接；
		     等做好 logo，在这里插一个元素并让它落进第一栏即可。 -->
		<div class="internal-links">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/blog">文章</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		/* 故意不用纯黑：底下的星点会透出来，页头下沿就不会出现一条硬边。
		   backdrop-filter 把透出来的背景再糊一层，保证导航文字依然清楚。 */
		background: rgba(0, 0, 0, 0.55);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
	}

	/* 用三栏网格而不是 flex：左右两栏各占一份、中间那栏自然居中。
	   删掉站点名之后导航链接只剩自己一个子元素，若不显式指定栏位，
	   它会自动落进第一栏跑到最左边去——所以下面钉死在第 2 栏。 */
	nav {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
	}

	.internal-links {
		grid-column: 2;
		/* 导航固定用系统 UI 字体。它在首页会继承 body 的等宽字体，
		   中文落进等宽栈之后字形很别扭——这块不该跟着终端风格走。 */
		font-family: var(--font-sans);
	}

	/* 配色：普通白 #dcdfe4、当前页蓝 #61afef。
	   这三个 <a> 由 HeaderLink 渲染，但它们带着本组件的 data-astro-cid
	   标记，所以在这里就能上色，不用改 HeaderLink。 */
	nav a {
		/* 横向内边距给足：字号降到 0.9rem 之后 0.5em 只剩 7px，三项挤在一起。
		   用 em 是为了让它跟着字号一起缩放。 */
		padding: 1em 1.1em;
		/* 字号比正文小一档：导航不该和正文抢注意力。
		   padding 用的是 em，所以会跟着一起缩小，页头整体变矮。 */
		font-size: 0.9rem;
		color: #dcdfe4;
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}

	nav a.active {
		text-decoration: none;
		color: #61afef;
		border-bottom-color: #61afef;
	}
</style>
