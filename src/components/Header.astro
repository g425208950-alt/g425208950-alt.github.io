---
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<!-- 站点名先不显示（还没有 logo）。navbar 用三栏网格，中间那栏放导航链接；
		     等做好 logo，在这里插一个元素并让它落进第一栏即可。 -->
		<div class="internal-links">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/blog">文章</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: #000;
		/* 终端里没有阴影，改用一条细线分隔 */
		border-bottom: 1px solid #21262d;
	}

	/* 用三栏网格而不是 flex：左右两栏各占一份、中间那栏自然居中。
	   删掉站点名之后导航链接只剩自己一个子元素，若不显式指定栏位，
	   它会自动落进第一栏跑到最左边去——所以下面钉死在第 2 栏。 */
	nav {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
	}

	.internal-links {
		grid-column: 2;
	}

	/* 终端配色，和首页同一套：普通白 #dcdfe4、蓝 #61afef。
	   这三个 <a> 由 HeaderLink 渲染，但它们带着本组件的 data-astro-cid
	   标记，所以在这里就能上色，不用改 HeaderLink。 */
	nav a {
		padding: 1em 0.5em;
		/* 字号比正文小一档：导航不该和正文抢注意力。
		   padding 用的是 em，所以会跟着一起缩小，页头整体变矮。 */
		font-size: 0.9rem;
		color: #dcdfe4;
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}

	nav a.active {
		text-decoration: none;
		color: #61afef;
		border-bottom-color: #61afef;
	}
</style>
