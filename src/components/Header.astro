---
import { SITE_TITLE } from '../consts';
import { basePath } from '../utils/url';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href={basePath}>{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/blog">文章</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	/* 用三栏网格而不是 flex：左右两栏各占一份、中间那栏自然居中。
	   这样即使没有社交图标，导航链接也仍然停在原来居中的位置。
	   （若用 justify-content: space-between，删掉第三个子元素后
	   链接会被推到最右边。） */
	nav {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
	}
	nav a {
		padding: 1em 0.5em;
		/* --black 的值是 "15, 18, 25" 这种分量列表，必须套在 rgb() 里才是合法颜色 */
		color: rgb(var(--black));
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
</style>
