---
import { AUTHOR } from '../consts';

const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} {AUTHOR}
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: #000;
		/* 和页头一样，用细线代替阴影 */
		border-top: 1px solid #21262d;
		color: #dcdfe4;
		text-align: center;
	}
</style>
