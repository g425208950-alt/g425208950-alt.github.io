---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { postSlug } from '../utils/post';
import { withBase } from '../utils/url';

const showDrafts = import.meta.env.DEV;

// post.id 是「相对 src/content/blog 的路径，不带扩展名」，例如
// languages/javascript/vue，所以第一段就是分类名。
const posts = (await getCollection('blog')).filter(
	(post) => showDrafts || !post.data.draft,
);

const byCategory = new Map();
for (const post of posts) {
	const slash = post.id.indexOf('/');
	const category = slash === -1 ? 'uncategorized' : post.id.slice(0, slash);
	if (!byCategory.has(category)) byCategory.set(category, []);
	byCategory.get(category).push(post);
}

// 每个分类取最新 5 篇：卡片高度因此不一样，瀑布感才出得来。
const PER_CARD = 5;

const categories = [...byCategory.entries()]
	.map(([name, items]) => {
		const sorted = items.sort(
			(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
		);
		return {
			name,
			count: items.length,
			latest: sorted.slice(0, PER_CARD),
			rest: Math.max(0, items.length - PER_CARD),
		};
	})
	.sort((a, b) => b.count - a.count);

// ---------- 站点统计 ----------
// 口径：先去掉代码块（它不该算进「写了多少字」），然后中日韩字符按「字」算、
// 拉丁字母数字按「词」算，这样中英混排的笔记也能得出一个合理的数字。
// 想改口径只动这个函数。
function countWords(text) {
	const withoutCode = text.replace(/```[\s\S]*?```/g, '');
	const cjk = (withoutCode.match(/[\u4e00-\u9fff]/g) ?? []).length;
	const latin = (withoutCode.match(/[A-Za-z0-9]+/g) ?? []).length;
	return cjk + latin;
}

// 统计只算**已发布**的文章，和 dev 下分类墙是否显示草稿无关。
// 所以本地开发时「统计里的篇数」会小于「列出来的文章数」，那是正常的。
const published = posts.filter((post) => !post.data.draft);

const totalWords = published.reduce((sum, post) => sum + countWords(post.body ?? ''), 0);

// 起始日期写死，不从文章里倒推 —— 免得某篇旧文章的日期把天数带偏。
// 注意天数是构建那一刻算出来的，只在重新部署时更新。
const START_DATE = new Date('2025-05-12T00:00:00Z');
const days = Math.max(
	1,
	Math.round((Date.now() - START_DATE.getTime()) / 86_400_000),
);

const stats = [
	`${published.length} 篇`,
	`${(totalWords / 1000).toFixed(1)}k 字`,
	`${days} 天`,
];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} appendSiteName={false} />
	</head>
	<body class="page-home">
		<Header />
		<main>
			<!-- 页面上不放可见的大标题（站点名已在 Header 里），
			     但保留一个 h1 给屏幕阅读器和搜索引擎 -->
			<h1 class="sr-only">{SITE_TITLE}</h1>

			<p class="stats">
				{stats.map((item) => <span>{item}</span>)}
			</p>

			<div class="columns">
				{
					categories.map((cat) => (
						<section class="card">
							<h2>{cat.name}</h2>
							<p class="count">{cat.count} 篇</p>
							<ul>
								{cat.latest.map((post) => (
									<li>
										<a href={withBase(`blog/${postSlug(post)}/`)}>{post.data.title}</a>
									</li>
								))}
							</ul>
							{cat.rest > 0 && <p class="rest">还有 {cat.rest} 篇…</p>}
						</section>
					))
				}
			</div>
		</main>
		<Footer />
	</body>
</html>
