---
import type { HTMLAttributes } from 'astro/types';
import { basePath, withBase } from '../utils/url';

// 样式不写在这个文件里：.nav-link 和 .nav-link.active 定义在 global.css。
// 以前 Header.astro 能选中这个 <a>，靠的是 Astro 把父组件的作用域标记沿组件树
// 传给子组件的根元素——那是个隐式依赖，样式改由普通样式表下发后就断了。
// 现在换成一个显式的 class，两边都不用再关心作用域。
type Props = HTMLAttributes<'a'>; 

const { href, class: className, ...props } = Astro.props;

// 调用方传进来的 href 是“不含 base”的站内路径（如 "/blog"），
// 由 withBase 统一补上 base，这样项目站点下链接才不会 404。
const resolvedHref = withBase(href ?? '');

// 判断当前导航项是否处于激活状态；比较前先把 base 剥掉。
const pathname = Astro.url.pathname.replace(basePath, '');
const subpath = pathname.match(/[^\/]+/g);
const isActive = href === pathname || href === '/' + (subpath?.[0] || '');
---

<a href={resolvedHref} class:list={['nav-link', className, { active: isActive }]} {...props}>
	<slot />
</a>
