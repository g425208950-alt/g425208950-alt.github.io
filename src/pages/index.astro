---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { postSlug } from '../utils/post';
import { withBase } from '../utils/url';

const showDrafts = import.meta.env.DEV;

// post.id 是「相对 src/content/blog 的路径，不带扩展名」，例如
// languages/javascript/vue，所以第一段就是分类名。
const posts = (await getCollection('blog')).filter(
	(post) => showDrafts || !post.data.draft,
);

const byCategory = new Map();
for (const post of posts) {
	const slash = post.id.indexOf('/');
	const category = slash === -1 ? 'uncategorized' : post.id.slice(0, slash);
	if (!byCategory.has(category)) byCategory.set(category, []);
	byCategory.get(category).push(post);
}

// 每个分类取最新 5 篇：卡片高度因此不一样，瀑布感才出得来。
const PER_CARD = 5;

const categories = [...byCategory.entries()]
	.map(([name, items]) => {
		const sorted = items.sort(
			(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
		);
		return {
			name,
			count: items.length,
			latest: sorted.slice(0, PER_CARD),
			rest: Math.max(0, items.length - PER_CARD),
		};
	})
	.sort((a, b) => b.count - a.count);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			/* 终端配色。四个角色就是你要的：普通白、品红、蓝、黄。
			   值取的是常见的 One Dark 终端调色板，想换整套风格只改这四行。
			   深色只覆盖这一页的 body —— Astro 的作用域样式会给 body 加上
			   data-astro-cid 属性，特异性高于 global.css 里的 body 规则，
			   所以 global.css 不用动。 */
			body {
				/* background 是简写，会顺带清掉 global.css 的顶部渐变 */
				background: #000;
				color: #dcdfe4;
				/* 命令行观感的关键：等宽字体。中文会落到后面的中文字体上 */
				font-family:
					'Cascadia Mono', 'JetBrains Mono', Consolas, 'DejaVu Sans Mono',
					'Sarasa Mono SC', 'Microsoft YaHei', monospace;
			}

			main {
				width: 1100px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 3rem 1em 5rem;
			}

			/* 多列瀑布：每列一条，像终端里的分栏输出 */
			.columns {
				columns: 3;
				column-gap: 2.5rem;
			}

			.card {
				/* 关键：禁止一个块被拆到相邻两列去。
				   这里刻意不给背景和边框 —— 终端里没有卡片。 */
				break-inside: avoid;
				margin: 0 0 2rem;
			}

			/* global.css 把 h1~h6 设成了近黑色，深色底上必须逐项覆盖。
			   分类名给品红 */
			.card h2 {
				margin: 0 0 0.2rem;
				font-size: 1.15rem;
				letter-spacing: 0;
				color: #c678dd;
			}

			/* 篇数给黄色 */
			.count {
				margin: 0 0 0.7rem;
				font-size: 0.8rem;
				color: #e5c07b;
			}

			.card ul {
				margin: 0;
				padding: 0;
				list-style: none;
			}

			.card li {
				margin-bottom: 0.3rem;
				font-size: 0.9rem;
				line-height: 1.45;
			}

			.card li:last-child {
				margin-bottom: 0;
			}

			/* 文章标题给蓝色，对应终端 ls 输出里的目录名 */
			.card a {
				color: #61afef;
				text-decoration: none;
			}

			.card a:hover {
				text-decoration: underline;
			}

			/* 「还有 N 篇」保持普通白 */
			.rest {
				margin: 0.7rem 0 0;
				font-size: 0.8rem;
				color: #dcdfe4;
			}

			@media (max-width: 900px) {
				.columns {
					columns: 2;
				}
			}

			@media (max-width: 600px) {
				.columns {
					columns: 1;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<!-- 页面上不放可见的大标题（站点名已在 Header 里），
			     但保留一个 h1 给屏幕阅读器和搜索引擎 -->
			<h1 class="sr-only">{SITE_TITLE}</h1>

			<div class="columns">
				{
					categories.map((cat) => (
						<section class="card">
							<h2>{cat.name}</h2>
							<p class="count">{cat.count} 篇</p>
							<ul>
								{cat.latest.map((post) => (
									<li>
										<a href={withBase(`blog/${postSlug(post)}/`)}>{post.data.title}</a>
									</li>
								))}
							</ul>
							{cat.rest > 0 && <p class="rest">还有 {cat.rest} 篇…</p>}
						</section>
					))
				}
			</div>
		</main>
		<Footer />
	</body>
</html>
